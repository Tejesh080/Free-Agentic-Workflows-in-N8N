# Revenue Swarm control plane — configuration.
#
# Copy to .env.local. Never commit a filled-in copy; .gitignore covers .env.*
# except this file.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development, no infrastructure required. Runs PGlite (real Postgres in
# WebAssembly) against ./.pglite, applying the same migrations and the same row
# level security policies as a server.
DATABASE_URL=pglite://.pglite
#
# Production: a Postgres connection string. Connect as revenue_swarm_app, NOT as
# the database owner and NOT as a Supabase service role — row level security is
# enforced against this role, and a service role bypasses it entirely.
# DATABASE_URL=postgres://revenue_swarm_app:...@db.<project>.supabase.co:5432/postgres
DATABASE_POOL_MAX=10
# Set to "disable" only against a local plaintext server. Anything else keeps
# certificate verification on.
# DATABASE_SSL=disable

# ---------------------------------------------------------------------------
# Human sessions
# ---------------------------------------------------------------------------
# Supabase project JWT secret, used to verify HS256 access tokens. Projects on
# asymmetric signing keys need a JWKS path, which is not implemented — see
# docs/SECURITY.md MEDIUM-2.
SUPABASE_JWT_SECRET=

# Local development only: the user id a server-rendered page acts as when no
# session cookie is present. Ignored unless DATABASE_URL is a pglite:// url, so
# this cannot become a bypass against a hosted database.
DEMO_USER_ID=11111111-1111-4111-8111-111111111111

# ---------------------------------------------------------------------------
# Execution engine
# ---------------------------------------------------------------------------
PUBLIC_APP_URL=http://localhost:3000

# Where to dispatch a lead. Dispatch fails closed: with any of the three values
# below unset, POST /v1/leads stores the lead, records the failure against the
# execution, and returns 503 — it does not silently skip the engine.
N8N_INGEST_WEBHOOK_URL=
# The shared ingress secret the n8n webhook already checks. Same value as the
# SWARM_INGEST_KEY variable set inside n8n.
SWARM_INGEST_KEY=
# Signs control plane -> engine requests. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
N8N_DISPATCH_SECRET=
N8N_DISPATCH_TIMEOUT_MS=10000

# Verifies engine -> control plane callbacks. A DIFFERENT value from the
# dispatch secret, so a leak of one direction does not grant the other.
N8N_CALLBACK_SECRET=

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# Applied to POST /v1/leads only, because that is the endpoint where one
# accepted request buys a model call. Two subjects are counted: the credential
# and the organization, so minting extra keys is not a way around the ceiling.
RATE_LIMIT_INGEST_PER_KEY=60
RATE_LIMIT_INGEST_PER_ORG=300
RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# Database deployment and testing (not read by the application)
# ---------------------------------------------------------------------------
# Owner/superuser connection used by scripts/deploy-db.ts and verify-db.ts.
# ADMIN_DATABASE_URL=postgres://postgres:...@db.<project>.supabase.co:5432/postgres
#
# Gives revenue_swarm_app a login and a password at deploy time. Deliberately
# not in a migration: the role's existence and grants are schema, its
# credentials are deployment.
# APP_DB_PASSWORD=
#
# Point the test suite at a real server instead of PGlite. Each test gets its
# own database cloned from a migrated template.
#   local:    postgres://postgres:...@127.0.0.1:55432/postgres
# TEST_DATABASE_URL=
