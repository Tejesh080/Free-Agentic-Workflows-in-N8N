# ---------------------------------------------------------------------------
# Secrets and local-only material. Nothing here may ever reach git history.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
credentials
credentials*
*.credentials.json
private/
tmp/
.tmp/
*.secret.*
*.secret
secrets/
*.pem
*.key
!*.public.key

# Live (unsanitised) workflow exports pulled straight from an n8n instance.
# These may contain credential IDs and instance identifiers.
workflows/**/workflow.live.json
workflows/**/*.live.json
.n8n-live/

# Build and tooling
node_modules/
.next/
next-env.d.ts
*.tsbuildinfo

# Local PGlite data directory. A real Postgres cluster on disk, seeded by
# scripts/seed-demo.ts; regenerate it rather than committing it.
saas/.pglite/
.build/
__pycache__/
*.pyc
.venv/
venv/
dist/
coverage/

# Local build notes. Instance ids, project ids and a running to-do list -
# useful while building, noise in a published repository.
BUILD_STATE.md

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
