    {
      "id": "46bcf577-5808-42ae-ad41-106c3692f0df",
      "name": "Execute Restricted Tool",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// The only side effects this workflow can produce are the ones written here.\n// The demo tools return static, invented data. A data-changing intent is never\n// executed even when Governance approved it: the approval is recorded and a\n// human completes the action. That is what keeps a public demo safe to point a\n// webhook at.\nconst state = $('Resolve Intent and Tool').first().json;\n\nlet governance = null;\ntry { governance = $('Request Approval (05)').first().json; } catch (e) { governance = null; }\nif (governance && governance.json) { governance = governance.json; }\nif (!governance) { try { governance = $('Read-Only Intent').first().json; } catch (e) { governance = null; } }\ngovernance = governance || { decision: 'unknown', approved: false, risk_level: 'HIGH' };\n\nconst HOURS = { monday: '9am to 6pm', tuesday: '9am to 6pm', wednesday: '9am to 6pm', thursday: '9am to 8pm', friday: '9am to 8pm', saturday: '10am to 5pm', sunday: '11am to 4pm' };\n\nlet toolResult = null;\nlet executed = false;\nlet refusal = null;\n\nif (state.intent === 'unsupported') {\n  refusal = 'The request was not recognised as one of the supported intents.';\n} else if (state.missing_slots.length) {\n  refusal = 'Cannot act yet: missing ' + state.missing_slots.join(' and ') + '.';\n} else if (state.changes_data) {\n  refusal = governance.approved\n    ? 'Approved by governance, but this demo never executes data-changing actions. The approval has been recorded for a human to action.'\n    : 'This action changes data and was not approved (' + governance.decision + ').';\n} else if (state.intent === 'check_opening_hours') {\n  toolResult = { hours: HOURS, note: 'Invented demo opening hours.' };\n  executed = true;\n} else if (state.intent === 'check_order_status') {\n  toolResult = { order_reference: state.slots.order_reference, status: 'in transit', last_scan: 'Adelaide depot', expected: '2 business days', note: 'Invented demo order data.' };\n  executed = true;\n} else if (state.intent === 'get_delivery_estimate') {\n  toolResult = { postcode: state.slots.postcode, estimate_business_days: 3, note: 'Invented demo delivery estimate.' };\n  executed = true;\n} else if (state.intent === 'speak_to_human') {\n  toolResult = { queued: true, note: 'A handover would be queued here. Nothing is actually sent in the demo.' };\n  executed = true;\n}\n\nreturn [{\n  json: Object.assign({}, state, {\n    governance: { decision: governance.decision, approved: !!governance.approved, risk_level: governance.risk_level, reason: governance.decision_reason || null },\n    tool_executed: executed,\n    tool_result: toolResult,\n    refusal: refusal,\n    tool_result_text: toolResult ? JSON.stringify(toolResult) : (refusal || 'no result'),\n    t_tool_ms: Date.now()\n  })\n}];"
      }
    },
