    {
      "id": "76b097c9-9d73-4de5-b57a-4603a5171487",
      "name": "Build Voice Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Per-stage latency, measured. A voice agent lives or dies on where the time\n// goes, so each hop is reported separately rather than as one opaque total.\nconst tool = $('Execute Restricted Tool').first().json;\n\nfunction unwrap(n) {\n  try { const v = $(n).first().json; return (v && v.json) ? v.json : v; } catch (e) { return null; }\n}\nconst reply = unwrap('Compose Spoken Reply (02 Router)');\nconst verification = unwrap('Verify Reply (09)');\nconst intentPromptMeta = unwrap('Get Intent Prompt (08)');\n\nconst items = $input.all();\nconst spoke = items.some(function (i) { return i.binary && Object.keys(i.binary).length > 0; });\nconst skipped = items.some(function (i) { return i.json && i.json.speech_skipped; });\n\nconst tEnd = Date.now();\nconst t0 = Number(tool.t_start_ms || 0);\nfunction span(a, b) {\n  const x = Number(a || 0); const y = Number(b || 0);\n  return (x > 0 && y > 0 && y >= x) ? (y - x) : null;\n}\n\nconst stages = {\n  transcription_ms: span(tool.t_start_ms, tool.t_transcribed_ms),\n  intent_ms: span(tool.t_transcribed_ms, tool.t_intent_ms),\n  tool_ms: span(tool.t_intent_ms, tool.t_tool_ms),\n  reply_verify_speech_ms: span(tool.t_tool_ms, tEnd),\n  total_ms: t0 ? (tEnd - t0) : null\n};\n\nconst costs = [];\nif (tool.classifier_router && tool.classifier_router.estimated_cost_usd) { costs.push(Number(tool.classifier_router.estimated_cost_usd)); }\nif (reply && reply.estimated_cost_usd) { costs.push(Number(reply.estimated_cost_usd)); }\n\nreturn [{\n  json: {\n    generated_at: new Date().toISOString(),\n    n8n_execution_id: $execution.id,\n    session_id: tool.session_id,\n    transcript: tool.transcript,\n    transcript_source: tool.transcript_source,\n    stt_error: tool.stt_error,\n    intent: tool.intent,\n    intent_confidence: tool.intent_confidence,\n    slots: tool.slots,\n    missing_slots: tool.missing_slots,\n    changes_data: tool.changes_data,\n    needs_confirmation: tool.needs_confirmation,\n    classifier_note: tool.classifier_note,\n    governance: tool.governance,\n    tool_executed: tool.tool_executed,\n    tool_result: tool.tool_result,\n    refusal: tool.refusal,\n    reply_text: reply && reply.ok ? String(reply.output || '') : null,\n    speech: { requested: !!tool.speak_reply, produced: spoke, skipped: !!skipped },\n    verification: verification ? { verified: verification.verified, score: verification.score, issues: verification.issues } : null,\n    prompts: { intent_router: intentPromptMeta ? { version: intentPromptMeta.version, sha: intentPromptMeta.sha, degraded: intentPromptMeta.degraded } : null },\n    models: {\n      intent: tool.classifier_router,\n      reply: reply ? { provider: reply.selected_provider, model: reply.selected_model, latency_ms: reply.latency_ms, estimated_cost_usd: reply.estimated_cost_usd } : null\n    },\n    latency_measured_ms: stages,\n    estimated_cost_usd_total: Math.round(costs.reduce(function (a, b) { return a + b; }, 0) * 1000000) / 1000000\n  }\n}];"
      }
    },
