      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Webhook payloads arrive in several shapes depending on the client, so read\n// defensively. Audio is optional: a text payload exercises the whole pipeline\n// downstream of transcription, which is what the automated tests use.\nconst j = $json || {};\nconst body = j.body || j;\nconst binary = $binary || {};\nconst audioKeys = Object.keys(binary);\n\nconst text = String(body.text || body.transcript || body.message || '').trim();\nconst hasAudio = audioKeys.length > 0;\n\nreturn {\n  json: {\n    session_id: String(body.session_id || ('sess-' + $execution.id)),\n    supplied_text: text,\n    has_audio: hasAudio,\n    audio_property: hasAudio ? audioKeys[0] : null,\n    speak_reply: String(body.speak_reply === undefined ? 'true' : body.speak_reply) !== 'false',\n    simulate_decision: String(body.simulate_decision || ''),\n    t_start_ms: Date.now()\n  }\n};"
      }
    },
