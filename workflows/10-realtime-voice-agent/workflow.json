    {
      "id": "06f02bd1-09ef-4452-9952-b5ef5e511149",
      "name": "Resolve Intent and Tool",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        40,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// The tool surface is a closed registry. The model chooses a name from it and\n// nothing else; an unknown name becomes 'unsupported' rather than an attempt to\n// do something undefined. Whether an intent changes data is declared HERE, not\n// by the model, and those intents are the ones sent to Governance.\nconst raw = ($json && $json.json) ? $json.json : $json;\n\n// The upstream state is whichever branch produced the transcript.\nlet base = null;\ntry { base = $('Capture Transcript').first().json; } catch (e) { base = null; }\nif (!base || base.transcript === undefined) {\n  try { base = $('Use Supplied Text').first().json; } catch (e) { base = base; }\n}\nbase = base || {};\n\nconst TOOLS = {\n  check_opening_hours:   { changes_data: false, required_slots: [] },\n  check_order_status:    { changes_data: false, required_slots: ['order_reference'] },\n  get_delivery_estimate: { changes_data: false, required_slots: ['postcode'] },\n  speak_to_human:        { changes_data: false, required_slots: [] },\n  cancel_order:          { changes_data: true,  required_slots: ['order_reference'] }\n};\n\nfunction repairJson(text) {\n  try { return JSON.parse(text); } catch (e) { /* continue */ }\n  const i = text.indexOf('{');\n  const j = text.lastIndexOf('}');\n  if (i >= 0 && j > i) { try { return JSON.parse(text.slice(i, j + 1)); } catch (e) { /* continue */ } }\n  return null;\n}\n\nlet parsed = null;\nlet note = null;\nif (raw && raw.ok && raw.output) {\n  parsed = repairJson(String(raw.output).replace(/^\\s*```(?:json)?/i, '').replace(/```\\s*$/, '').trim());\n  if (!parsed) { note = 'intent classifier response could not be parsed'; }\n} else {\n  note = 'intent classifier call failed: ' + ((raw && raw.error) ? raw.error : 'no output');\n}\nparsed = parsed || {};\n\nlet intent = String(parsed.intent || '').trim();\nif (!TOOLS[intent]) {\n  if (intent) { note = (note ? note + '; ' : '') + 'model proposed unregistered intent \"' + intent.slice(0, 40) + '\"'; }\n  intent = 'unsupported';\n}\n\nconst def = TOOLS[intent] || { changes_data: false, required_slots: [] };\nconst slots = (parsed.slots && typeof parsed.slots === 'object') ? parsed.slots : {};\nconst missing = def.required_slots.filter(function (s) {\n  return !slots[s] || String(slots[s]).trim() === '';\n});\nconst confidence = typeof parsed.confidence === 'number' ? parsed.confidence : 0;\n\nreturn {\n  json: Object.assign({}, base, {\n    intent: intent,\n    intent_confidence: confidence,\n    slots: slots,\n    missing_slots: missing,\n    changes_data: def.changes_data,\n    needs_governance: def.changes_data,\n    needs_confirmation: !!parsed.needs_confirmation || missing.length > 0 || confidence < 0.7 || def.changes_data,\n    classifier_note: note,\n    classifier_router: { provider: raw ? raw.selected_provider : null, model: raw ? raw.selected_model : null, latency_ms: raw ? raw.latency_ms : null, estimated_cost_usd: raw ? raw.estimated_cost_usd : null },\n    t_intent_ms: Date.now()\n  })\n};"
      }
    },
