# =============================================================================
# Free Agentic Workflows in n8n - environment template
#
# Copy to .env and fill in. .env is git-ignored and must never be committed.
#   cp .env.example .env
#
# NOTHING in this repository reads .env at n8n runtime. n8n stores secrets in
# its own encrypted credential store. This file is for the helper scripts in
# scripts/ (import/export/validate) and for documenting which services each
# workflow needs. See docs/CONNECTIONS.md for the full checklist.
# =============================================================================

# -----------------------------------------------------------------------------
# n8n instance - REQUIRED for scripts/import-workflows.py and export-workflows.py
# -----------------------------------------------------------------------------
# Base URL of your n8n instance, no trailing slash.
N8N_BASE_URL=https://your-instance.app.n8n.cloud
# Public API key: n8n > Settings > n8n API > Create an API key.
N8N_API_KEY=

# -----------------------------------------------------------------------------
# Model providers
#
# If your n8n instance has AI Gateway credits enabled, Gemini / OpenAI /
# Anthropic nodes get a managed credential automatically and you do NOT need
# these keys. Set them only when running against your own provider accounts.
# -----------------------------------------------------------------------------
# Used by: 02 router (gemini branch + fallback), 03 RAG embeddings, 06, 10
GOOGLE_GEMINI_API_KEY=
# Used by: 02 router (openai branch), 10 voice (Whisper STT + TTS)
OPENAI_API_KEY=
# Used by: 02 router (anthropic branch)
ANTHROPIC_API_KEY=
# Optional local provider. Register it in the router's CANDIDATES list to serve
# privacy=local_only requests. Without it the router refuses those requests.
OLLAMA_BASE_URL=http://localhost:11434

# -----------------------------------------------------------------------------
# Vector store - REQUIRED for 03 Production RAG Intelligence
# -----------------------------------------------------------------------------
QDRANT_URL=https://your-cluster.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=agentic_rag_demo

# -----------------------------------------------------------------------------
# Web research - REQUIRED for 04 Autonomous Research Agent
# -----------------------------------------------------------------------------
# Firecrawl is the default search/scrape backend.
FIRECRAWL_API_KEY=

# -----------------------------------------------------------------------------
# GitOps prompt registry - 08 (public repos need no token)
# -----------------------------------------------------------------------------
PROMPT_REPO_OWNER=Tejesh080
PROMPT_REPO_NAME=Free-Agentic-Workflows-in-N8N
PROMPT_REPO_REF=main
# Only needed if the prompt repository is private, or to raise the GitHub
# anonymous rate limit. Scope: contents:read on that repo only.
GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# Human-in-the-loop approvals - 05 Agent Governance
# -----------------------------------------------------------------------------
# Telegram is the default approval channel (sendAndWait).
TELEGRAM_BOT_TOKEN=
# Chat id that receives approval requests.
GOVERNANCE_APPROVER_CHAT_ID=
# Minutes an approval request stays valid before it auto-expires as denied.
GOVERNANCE_APPROVAL_TIMEOUT_MINUTES=60

# -----------------------------------------------------------------------------
# Analytics warehouse - 07 Conversational Analytics (OPTIONAL)
#
# The workflow ships with an n8n Data Table demo warehouse and runs without any
# of this. Set these only to point it at a real Postgres instead.
# Use a READ-ONLY role. The workflow never issues DDL or DML.
# -----------------------------------------------------------------------------
ANALYTICS_DB_HOST=
ANALYTICS_DB_PORT=5432
ANALYTICS_DB_NAME=
ANALYTICS_DB_USER=analytics_readonly
ANALYTICS_DB_PASSWORD=
# Optional: Google Search Console as a live analytics source.
GSC_PROPERTY_URL=

# -----------------------------------------------------------------------------
# ROI model inputs - consumed by docs/ROI-METHODOLOGY.md and the ROI calculator
# Every one of these is an ASSUMPTION you should replace with your own numbers.
# -----------------------------------------------------------------------------
ROI_LOADED_HOURLY_COST_USD=45
ROI_CURRENCY=USD
